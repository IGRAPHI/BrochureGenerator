# --- AI provider selection ---
# Which model provider to use: claude (default) | gemini | demo
AI_PROVIDER=claude

# Claude (preferred / default). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Gemini (optional alternative). Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash-exp)
# GEMINI_MODEL=gemini-2.0-flash-exp

# Legacy name still accepted for the Company Brochure Generator:
# GENAI_API_KEY=

# If no key is set, the app still runs in Demo Mode with illustrative output.
